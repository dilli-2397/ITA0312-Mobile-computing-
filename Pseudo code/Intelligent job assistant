<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intelligent Job Assistant</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #e8eaf6;
            text-align: center;
            padding: 20px;
        }
        .container {
            background: white;
            max-width: 500px;
            margin: auto;
            padding: 20px;
            border-radius: 12px;
        }
        input, select, button {
            width: 90%;
            padding: 12px;
            margin: 8px;
        }
        button {
            background: #3949ab;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Intelligent Job Assistant</h1>

    <h3>Register / Login</h3>
    <input id="username" placeholder="Username">
    <input id="password" type="password" placeholder="Password">
    <button onclick="register()">Register</button>
    <button onclick="login()">Login</button>

    <p id="message"></p>

    <div id="dashboard" hidden>
        <h2>Personal Details</h2>
        <input id="name" placeholder="Full Name">
        <input id="email" type="email" placeholder="Email">
        <input id="qualification" placeholder="Qualification">
        <input id="skills" placeholder="Skills">

        <h3>Resume Upload</h3>
        <input id="resume" type="file" accept=".pdf,.doc,.docx">

        <h3>Subscription</h3>
        <select id="subscription">
            <option>Free</option>
            <option>Premium</option>
        </select>

        <h3>Choose Job</h3>
        <select id="job">
            <option>Embedded Systems Engineer</option>
            <option>VLSI Design Engineer</option>
            <option>Software Developer</option>
            <option>Data Analyst</option>
        </select>

        <button onclick="submitDetails()">Submit Details</button>
        <div id="result"></div>
    </div>
</div>

<script>
    let users = {};

    function register() {
        let u = username.value;
        let p = password.value;

        if (!u || !p) {
            message.textContent = "Enter username and password";
        } else if (users[u]) {
            message.textContent = "Username already exists";
        } else {
            users[u] = p;
            message.textContent = "Registration successful";
        }
    }

    function login() {
        if (users[username.value] === password.value &&
            username.value !== "") {
            message.textContent = "Login successful";
            dashboard.hidden = false;
        } else {
            message.textContent = "Invalid login";
        }
    }

    function submitDetails() {
        if (!name.value.trim() || !email.value.trim()) {
            result.textContent = "Enter your name and email";
            return;
        }

        let file = resume.files.length ?
            resume.files[0].name : "No resume selected";

        result.innerHTML = "";

        let details = [
            "Name: " + name.value,
            "Email: " + email.value,
            "Qualification: " + qualification.value,
            "Skills: " + skills.value,
            "Resume: " + file,
            "Subscription: " + subscription.value,
            "Selected Job: " + job.value
        ];

        let heading = document.createElement("h3");
        heading.textContent = "Your Job Profile";
        result.appendChild(heading);

        details.forEach(function(item) {
            let p = document.createElement("p");
            p.textContent = item;
            result.appendChild(p);
        });
    }
</script>
</body>
</html>
